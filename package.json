{
  "name": "apexpulse",
  "version": "1.0.0",
  "private": true,
  "description": "ApexPulse - Cloud & Server Health Observability Dashboard",
  "author": "MohammedBoure",
  "license": "ISC",
  "scripts": {
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test": "npm run test:server && npm run test:client",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
